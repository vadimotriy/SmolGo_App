<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.WallQuestionActivity">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@color/title"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="24dp"
            android:layout_marginTop="20dp"
            android:drawableLeft="@drawable/ic_back"
            android:gravity="center"
            android:onClick="backActivity" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="54dp"
            android:layout_weight="1"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center"
            android:text="@string/wall"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="30sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_marginTop="30dp"
                android:id="@+id/question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:fontFamily="@font/roboto_medium"
                android:text="1"
                android:textAlignment="center"
                android:textColor="?attr/colorOnSurface"
                android:textSize="32sp" />

            <RadioGroup
                android:layout_marginTop="30dp"
                android:id="@+id/radioGroup"
                android:layout_width="match_parent"
                android:layout_height="match_parent" >

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/variant1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:text="RadioButton"
                    android:textSize="24sp"
                    android:textColor="?attr/colorOnSurface"
                    app:useMaterialThemeColors="false"
                    app:buttonTint="@color/radio_button_selector" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/variant2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:text="RadioButton"
                    android:textSize="24sp"
                    android:textColor="?attr/colorOnSurface"
                    app:useMaterialThemeColors="false"
                    app:buttonTint="@color/radio_button_selector" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/variant3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:text="RadioButton"
                    android:textSize="24sp"
                    android:textColor="?attr/colorOnSurface"
                    app:useMaterialThemeColors="false"
                    app:buttonTint="@color/radio_button_selector" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/variant4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:text="RadioButton"
                    android:textSize="24sp"
                    android:textColor="?attr/colorOnSurface"
                    app:useMaterialThemeColors="false"
                    app:buttonTint="@color/radio_button_selector" />

            </RadioGroup>

            <com.google.android.material.button.MaterialButton
                android:layout_marginTop="50dp"
                android:id="@+id/materialButton"
                android:layout_width="380dp"
                android:layout_height="80dp"
                android:backgroundTint="@color/title"
                android:fontFamily="@font/roboto_medium"
                android:onClick="nextClick"

                android:text="@string/answer"
                android:textColor="@color/white"
                android:textSize="24sp"
                app:cornerRadius="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="50dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>